# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
# Use ! prefix to force-include something excluded by defaults.
# Built-in defaults are already excluded: node_modules/, .git/, dist/, build/, out/, coverage/, *.lock, *.min.js, *.min.css, *.map, etc.

# Optional project-specific exclusions:
# .idea/
# .vscode/
# *.log
# tmp/
# .DS_Store

# Exclude previous Understand Anything outputs and temporary analysis files.
.understand-anything/
tmp/
intermediate/
